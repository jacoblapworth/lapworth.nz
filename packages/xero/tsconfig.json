{
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "@/styled/*": ["./.styled/*"],
      "@/storybook/*": ["./.storybook/*"],
      "@/*": ["./src/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "esnext"
  },
  "include": ["src", ".storybook", ".styled", "panda.config.ts"],
  "exclude": ["**/node_modules", "dist", ".turbo", ".next", "storybook-static"],
  "extends": "@total-typescript/tsconfig/bundler/dom/library-monorepo"
}
